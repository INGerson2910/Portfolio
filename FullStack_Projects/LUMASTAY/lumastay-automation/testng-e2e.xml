<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="LumaStay E2E Suite" verbose="1" thread-count="1">

    <listeners>
        <listener class-name="com.lumastay.automation.listeners.TestListener"/>
    </listeners>

    <test name="End-to-End Tests">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="e2e"/>
            </run>
        </groups>
        <packages>
            <package name="com.lumastay.automation.tests"/>
        </packages>
    </test>

</suite>
